{
  "name": "shippingwish-website",
  "version": "1.0.0",
  "description": "Shipping Wish LLC - Truck Dispatch Services website with backend (Resend email + auth)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "mobile:driver": "npm --prefix mobile/driver-app start",
    "mobile:carrier": "npm --prefix mobile/loadnexus-carrier start",
    "mobile:tms": "npm --prefix mobile/shippingwish-tms start",
    "mobile:broker": "npm --prefix mobile/loadnexus-broker start",
    "mobile:driver:tunnel": "npm --prefix mobile/driver-app start -- --tunnel",
    "mobile:carrier:tunnel": "npm --prefix mobile/loadnexus-carrier start -- --tunnel",
    "mobile:tms:tunnel": "npm --prefix mobile/shippingwish-tms start -- --tunnel",
    "mobile:broker:tunnel": "npm --prefix mobile/loadnexus-broker start -- --tunnel",
    "build:driver:apk": "npm --prefix mobile/driver-app run eas-build",
    "build:carrier:apk": "npm --prefix mobile/loadnexus-carrier run eas-build",
    "build:tms:apk": "npm --prefix mobile/shippingwish-tms run eas-build",
    "build:broker:apk": "npm --prefix mobile/loadnexus-broker run eas-build",
    "build:loadsnexus": "npm --prefix apps/loadsnexus run build",
    "build:shippingwish": "npm --prefix apps/shippingwish run build",
    "build:all": "npm --prefix apps/loadsnexus run build && npm --prefix apps/shippingwish run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "resend": "^3.5.0",
    "stripe": "^22.4.0",
    "twilio": "^5.13.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
