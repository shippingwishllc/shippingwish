{
  "manifest_version": 3,
  "name": "Shipping Wish — DAT One AI Dispatcher",
  "version": "1.0.0",
  "description": "1-Click autonomous freight load ingestion & driver SMS dispatcher for DAT One, DAT Power, and Truckstop.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*.dat.com/*",
    "https://*.truckstop.com/*",
    "*://localhost/*",
    "https://shippingwish.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shipping Wish Dispatcher",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dat.com/*",
        "https://*.truckstop.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
