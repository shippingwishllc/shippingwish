{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/superadmin",
      "destination": "/superadmin/index.html"
    },
    {
      "source": "/superadmin-login",
      "destination": "/superadmin-login.html"
    },
    {
      "source": "/",
      "has": [{"type": "host", "value": "(?:www\\.)?loadsnexus\\.com"}],
      "destination": "/loadsnexus/index.html"
    },
    {
      "source": "/index",
      "has": [{"type": "host", "value": "(?:www\\.)?loadsnexus\\.com"}],
      "destination": "/loadsnexus/index.html"
    },
    {
      "source": "/board",
      "has": [{"type": "host", "value": "(?:www\\.)?loadsnexus\\.com"}],
      "destination": "/loadsnexus/index.html"
    },
    {
      "source": "/loads",
      "has": [{"type": "host", "value": "(?:www\\.)?loadsnexus\\.com"}],
      "destination": "/loadsnexus/index.html"
    },
    {
      "source": "/post-load",
      "has": [{"type": "host", "value": "(?:www\\.)?loadsnexus\\.com"}],
      "destination": "/loadsnexus/index.html"
    },
    {
      "source": "/login",
      "has": [{"type": "host", "value": "(?:www\\.)?loadsnexus\\.com"}],
      "destination": "/loadsnexus/index.html"
    },
    {
      "source": "/checkout",
      "has": [{"type": "host", "value": "(?:www\\.)?loadsnexus\\.com"}],
      "destination": "/loadsnexus/index.html"
    },
    {
      "source": "/assets/(.*)",
      "has": [{"type": "host", "value": "(?:www\\.)?loadsnexus\\.com"}],
      "destination": "/loadsnexus/assets/$1"
    },
    {
      "source": "/support",
      "has": [{"type": "host", "value": "(?:www\\.)?loadsnexus\\.com"}],
      "destination": "/loadsnexus/support.html"
    },
    {
      "source": "/contact",
      "has": [{"type": "host", "value": "(?:www\\.)?loadsnexus\\.com"}],
      "destination": "/loadsnexus/support.html"
    },
    {
      "source": "/privacy-policy",
      "has": [{"type": "host", "value": "(?:www\\.)?loadsnexus\\.com"}],
      "destination": "/loadsnexus/privacy-policy.html"
    },
    {
      "source": "/privacy",
      "has": [{"type": "host", "value": "(?:www\\.)?loadsnexus\\.com"}],
      "destination": "/loadsnexus/privacy-policy.html"
    },
    {
      "source": "/terms-of-service",
      "has": [{"type": "host", "value": "(?:www\\.)?loadsnexus\\.com"}],
      "destination": "/loadsnexus/terms-of-service.html"
    },
    {
      "source": "/terms",
      "has": [{"type": "host", "value": "(?:www\\.)?loadsnexus\\.com"}],
      "destination": "/loadsnexus/terms-of-service.html"
    },
    {
      "source": "/loadsnexus.css",
      "has": [{"type": "host", "value": "(?:www\\.)?loadsnexus\\.com"}],
      "destination": "/loadsnexus/loadsnexus.css"
    },
    {
      "source": "/",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/index.html"
    },
    {
      "source": "/index",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/index.html"
    },
    {
      "source": "/book",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/book.html"
    },
    {
      "source": "/track",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/track.html"
    },
    {
      "source": "/login",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/login.html"
    },
    {
      "source": "/signup",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/login.html"
    },
    {
      "source": "/erp",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/erp.html"
    },
    {
      "source": "/driver",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/driver/index.html"
    },
    {
      "source": "/driver/(.*)",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/driver/$1"
    },
    {
      "source": "/passenger",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/passenger/index.html"
    },
    {
      "source": "/passenger/(.*)",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/passenger/$1"
    },
    {
      "source": "/book/success",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/book/success.html"
    },
    {
      "source": "/contact",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/contact.html"
    },
    {
      "source": "/terms",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/terms.html"
    },
    {
      "source": "/privacy-policy",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/privacy-policy.html"
    },
    {
      "source": "/cancellation",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/cancellation.html"
    },
    {
      "source": "/services/(.*)",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/services/$1.html"
    },
    {
      "source": "/airports/(.*)",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/airports/$1.html"
    },
    {
      "source": "/images/(.*)",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/images/$1"
    },
    {
      "source": "/css/(.*)",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/css/$1"
    },
    {
      "source": "/js/(.*)",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/js/$1"
    },
    {
      "source": "/favicon.svg",
      "has": [{"type": "host", "value": "(?:www\\.)?nyclimowish\\.com"}],
      "destination": "/nyclimowish/favicon.svg"
    },
    {
      "source": "/",
      "has": [{"type": "host", "value": "(?:www\\.)?buywishonline\\.com"}],
      "destination": "/buywishonline/index.html"
    },
    {
      "source": "/index",
      "has": [{"type": "host", "value": "(?:www\\.)?buywishonline\\.com"}],
      "destination": "/buywishonline/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "headers": [
    {
      "source": "/",
      "has": [{"type": "host", "value": "(?:www\\.)?loadsnexus\\.com"}],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/loadsnexus/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/css/design-system.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/loadsnexus/loadsnexus.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/pricing",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/app-shell.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/css/marketing.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/site-chrome.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
