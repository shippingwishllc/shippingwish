# ==============================================================================
# SHIPPING WISH LLC — Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# NODE_ENV=production

# ------------------------------------------------------------------------------
# DATABASE — PostgreSQL
# Provide either DATABASE_URL (preferred for hosted Postgres, e.g. Neon, Supabase)
# or individual PG* variables for local development.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/shippingwish?sslmode=require

# Local development alternative (ignored if DATABASE_URL is set):
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=yourpassword
PGDATABASE=shippingwish

# ------------------------------------------------------------------------------
# AUTHENTICATION
# ------------------------------------------------------------------------------
# Strong random secret for JWT signing — generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-characters

# ------------------------------------------------------------------------------
# EMAIL — Resend (https://resend.com)
# Used for contact forms, carrier outreach, onboarding packets, notifications.
# ------------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
MAIL_FROM=Shipping Wish <info@shippingwish.com>

# Admin email addresses that receive contact form submissions (comma separated):
ADMIN_EMAIL_1=admin@shippingwish.com
ADMIN_EMAIL_2=owner@shippingwish.com

# ------------------------------------------------------------------------------
# PAYMENTS — Stripe (https://stripe.com)
# Used for generating Stripe invoices and accepting dispatch fee payments.
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=your_stripe_secret_key_here
# STRIPE_SECRET_KEY=your_stripe_test_secret_key_here  # for testing
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# ------------------------------------------------------------------------------
# FILE STORAGE
# Option A: AWS S3
# Option B: Cloudflare R2 (S3-compatible)
# Option C: Leave empty to use local filesystem (development only — breaks Vercel)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=s3
# STORAGE_PROVIDER=r2

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=shippingwish-documents

# Cloudflare R2 (uses S3-compatible SDK):
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shippingwish-documents
R2_PUBLIC_URL=https://documents.shippingwish.com

# ------------------------------------------------------------------------------
# MAPS & GEOCODING
# Option A: Google Maps (best accuracy, requires billing account)
# Option B: Leave empty to use OpenStreetMap/Nominatim (free, no key required)
# ------------------------------------------------------------------------------
MAPS_PROVIDER=openstreetmap
# MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# SMS — Twilio (https://twilio.com)
# Used for driver notifications and CRM outreach SMS.
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+19177370021

# ------------------------------------------------------------------------------
# VOIP — OpenPhone (https://openphone.com)
# Used for CRM 1-click call deeplinks and call activity webhooks.
# ------------------------------------------------------------------------------
OPENPHONE_API_KEY=
OPENPHONE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# FMCSA / OPEN DATA
# Used for carrier search and CRM lead enrichment.
# FMCSA Licensing & Insurance API key (register at: ai.fmcsa.dot.gov)
# ------------------------------------------------------------------------------
FMCSA_API_KEY=

# ------------------------------------------------------------------------------
# AI / OPENAI (Optional — future load matching and document OCR)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# DEPLOYMENT — Vercel
# Set these in your Vercel project dashboard, not here.
# All variables above must be added to Vercel environment variables.
# ------------------------------------------------------------------------------
# VERCEL_URL is auto-set by Vercel.
# APP_URL is the canonical production URL used in emails/links:
APP_URL=https://www.shippingwish.com
