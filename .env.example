# ==============================================================================
# SHIPPING WISH LLC — Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# NODE_ENV=production

# ------------------------------------------------------------------------------
# DATABASE — PostgreSQL
# Provide either DATABASE_URL (preferred for hosted Postgres, e.g. Neon, Supabase)
# or individual PG* variables for local development.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/shippingwish?sslmode=require

# Local development alternative (ignored if DATABASE_URL is set):
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=yourpassword
PGDATABASE=shippingwish

# ------------------------------------------------------------------------------
# AUTHENTICATION
# ------------------------------------------------------------------------------
# Strong random secret for JWT signing — generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-characters

# ------------------------------------------------------------------------------
# EMAIL — Resend (https://resend.com)
# Resend SENDS mail. It is not Gmail. Two-way works like this:
#   SEND  = Resend API (this app)
#   REPLY = Google Workspace / Microsoft 365 inbox on operations@...
#           AND/OR Resend inbound webhook → Admin Inbox (/inbox)
# You can use BOTH. Keep MX on Google. Add Resend SPF + DKIM on shippingwish.com.
# Do NOT send from onboarding@resend.dev in production.
#
# Setup:
# 1) resend.com → API Keys → create key → paste RESEND_API_KEY here and in Vercel
# 2) resend.com → Domains → add shippingwish.com → add DNS TXT (SPF) + CNAME (DKIM)
# 3) Add a DMARC TXT: v=DMARC1; p=quarantine; rua=mailto:operations@shippingwish.com
# 4) MAIL_FROM must be an address on that domain (operations@ or info@)
# 5) MAIL_REPLY_TO = the real inbox your team reads (Google Workspace)
# 6) Optional inbound: Resend → Webhooks → email.received →
#    https://www.shippingwish.com/api/email/inbound?secret=YOUR_SECRET
# ------------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
# Sending-only keys cannot read inbound email bodies. For Carrier Replies "Reload body",
# create a second key with Full access and set it here (keep RESEND_API_KEY for sending):
# RESEND_RECEIVING_API_KEY=re_full_access_key_here
MAIL_FROM=Shipping Wish LLC <operations@shippingwish.com>
MAIL_FROM_TRANSACTIONAL=Shipping Wish Operations <operations@shippingwish.com>
OPERATIONS_EMAIL=operations@shippingwish.com
MAIL_REPLY_TO=operations@shippingwish.com
# Optional: inbound tagging, e.g. shippingwish.com so Reply-To is replies+LEADID@shippingwish.com
# MAIL_REPLY_TAG_DOMAIN=shippingwish.com
# Shared secret for Resend inbound webhook → POST /api/email/inbound
RESEND_INBOUND_SECRET=

# Admin email addresses that receive contact form submissions:
ADMIN_EMAIL_1=admin@shippingwish.com
ADMIN_EMAIL_2=owner@shippingwish.com

# ------------------------------------------------------------------------------
# PAYMENTS — Stripe (https://stripe.com)
# 1) Dashboard → Developers → API keys → paste Secret + Publishable into Vercel.
# 2) Dashboard → Developers → Webhooks → Add endpoint:
#    https://www.shippingwish.com/api/billing/stripe-webhook
#    Events: checkout.session.completed, customer.subscription.updated,
#    customer.subscription.deleted, invoice.paid, invoice.payment_failed
# 3) Dashboard → Settings → Billing → Customer portal → turn ON (so carriers can cancel).
# 4) Optional: create weekly Products/Prices and set STRIPE_PRICE_* below.
#    If Price IDs are empty, Checkout creates prices automatically via price_data.
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_or_sk_live_from_stripe_dashboard
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_TRIAL_DAYS=7
# Weekly plans in cents: $149 / $350 / $500
STRIPE_PLAN_SOLO_CENTS=14900
STRIPE_PLAN_FLEET_CENTS=35000
STRIPE_PLAN_COMMAND_CENTS=50000
STRIPE_PLAN_CUSTOM_CENTS=50000
# Optional Dashboard Price IDs (recurring, interval=week)
STRIPE_PRICE_SOLO=
STRIPE_PRICE_FLEET=
STRIPE_PRICE_COMMAND=

# ------------------------------------------------------------------------------
# FILE STORAGE
# Option A: AWS S3
# Option B: Cloudflare R2 (S3-compatible)
# Option C: Leave empty to use local filesystem (development only — breaks Vercel)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=s3
# STORAGE_PROVIDER=r2

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=shippingwish-documents

# Cloudflare R2 (uses S3-compatible SDK):
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shippingwish-documents
R2_PUBLIC_URL=https://documents.shippingwish.com

# ------------------------------------------------------------------------------
# MAPS & GEOCODING
# Option A: Google Maps (best accuracy, requires billing account)
# Option B: Leave empty to use OpenStreetMap/Nominatim (free, no key required)
# ------------------------------------------------------------------------------
MAPS_PROVIDER=openstreetmap
# MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# SMS — Twilio (https://twilio.com)
# Used for CRM outreach and trial/ops texts. US law (TCPA): do not cold-text
# without consent. Every outbound SMS gets a STOP / HELP footer automatically.
#
# Setup:
# 1) twilio.com → Account SID + Auth Token
# 2) Buy a US number or use a Messaging Service (A2P 10DLC — required to reach
#    Verizon/AT&T reliably and stay out of the carrier spam filter)
# 3) Phone number → Messaging → "A message comes in" webhook:
#    https://www.shippingwish.com/api/voip/twilio-inbound
#    Method: HTTP POST
# 4) Register A2P 10DLC Brand + Campaign (Twilio console → Messaging → Trust Hub)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+19177370021
# Optional. If set, messages send through the Messaging Service instead of FROM.
# TWILIO_MESSAGING_SERVICE_SID=

# ------------------------------------------------------------------------------
# VOIP — OpenPhone (https://openphone.com)
# Used for CRM 1-click call deeplinks and call activity webhooks.
# ------------------------------------------------------------------------------
OPENPHONE_API_KEY=
OPENPHONE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# FMCSA / OPEN DATA
# Used for carrier search and CRM lead enrichment.
# FMCSA Licensing & Insurance API key (register at: ai.fmcsa.dot.gov)
# ------------------------------------------------------------------------------
FMCSA_API_KEY=

# Optional: LoadWrap broker Trust Score + bond (free tier 250 lookups/mo)
# Sign up at https://loadwrap.com/developers then paste the Bearer key here / in Vercel.
LOADWRAP_API_KEY=

# ------------------------------------------------------------------------------
# AI / OPENAI (Optional — load matching, document OCR, one-time /services images)
# Run locally: node scripts/generate-service-images.js
# ------------------------------------------------------------------------------
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# DEPLOYMENT — Vercel
# Set these in your Vercel project dashboard, not here.
# All variables above must be added to Vercel environment variables.
# ------------------------------------------------------------------------------
# VERCEL_URL is auto-set by Vercel.
# APP_URL is the canonical production URL used in emails/links:
APP_URL=https://www.shippingwish.com
